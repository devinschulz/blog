  "scripts": {
    "build": "hugo",
    "build:social": "node scripts/build-social-background.mjs",
    "format": "prettier --write \"**/*.{js,mjs,ts,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,json,css}\"",
    "typecheck": "tsc --noEmit",
    "serve": "hugo server",
    "check": "npm run typecheck && npm run build && node scripts/check-site.mjs",
    "check:a11y": "npm run build && playwright test",
    "check:all": "npm run check && npm run check:a11y",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/three": "^0.186.0",
    "hugo-bin": "^0.163.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "three": "^0.186.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,json,css}": "prettier --write"
  }
